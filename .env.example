# im-align e2e harness credentials template.
# Copy to .env, fill in real values, and load with: set -a && source .env && set +a
# .env contains live secrets; it is gitignored and must never be committed.
# Reference: docs/test/test-layers.md

# --- E2E_BRIDGE_* (L2 IM Integration and above) ---
# Credentials the harness feeds to the Bridge. The app behind the Bridge needs
# the long-connection event im.message.receive_v1 and the scopes in
# references/lark-scopes.json. E2E_BRIDGE_CHAT_ID is a dedicated test group;
# when unset, L2 falls back to im.chat_id in the launching repository's
# .im-align.yaml.
E2E_BRIDGE_FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
E2E_BRIDGE_FEISHU_APP_SECRET=changeme
E2E_BRIDGE_CHAT_ID=oc_xxxxxxxxxxxxxxxx

# The Bridge bot open_id is normally resolved from its app credentials.
# Optional override for environments where identity lookup is unavailable:
# E2E_BRIDGE_BOT_OPEN_ID=ou_xxxxxxxxxxxxxxxx

# --- E2E_SIMULATOR_* (Participant identity, L2 IM Integration and above) ---
# Credentials of the Participant that posts and verifies in the Thread as the
# dedicated test user. They belong to the simulator participant identity; the
# Bridge never reads them. Local runs load a fresh access token from an
# authorized CLI credential store; the harness never writes it to Bridge
# config or state.
E2E_SIMULATOR_USER_ACCESS_TOKEN=changeme

# CI does not store the short-lived access token. It stores the rotating OAuth
# refresh token and refreshes immediately before each serialized Feishu job.
# The refresh token must have been issued for the Bridge app above. A
# fine-grained PAT limited to this repository's Secrets: write permission
# persists each rotated refresh token through `gh secret set`; neither value
# reaches the Bridge.
E2E_SIMULATOR_USER_REFRESH_TOKEN=changeme
E2E_SIMULATOR_GITHUB_SECRETS_PAT=github_pat_changeme

# --- User Simulator LLM (OpenAI-compatible chat-completions endpoint) ---
E2E_SIMULATOR_LLM_BASE_URL=https://your-llm-endpoint.example.com/v1
E2E_SIMULATOR_LLM_API_KEY=changeme
E2E_SIMULATOR_LLM_MODEL=changeme

# --- E2E_EVALUATOR_LLM_* (Run Evaluator LLM) ---
# OpenAI-compatible chat-completions endpoint. Also used by
# tests/e2e/calibrate.py for rubric calibration.
E2E_EVALUATOR_LLM_BASE_URL=https://your-llm-endpoint.example.com/v1
E2E_EVALUATOR_LLM_API_KEY=changeme
E2E_EVALUATOR_LLM_MODEL=changeme

# --- Optional: archive root for run artifacts (transcript.json, rubric.json) ---
# Defaults to $XDG_STATE_HOME/im-align/e2e-runs (~/.local/state/im-align/e2e-runs).
# E2E_RUNS_DIR=/absolute/path/to/e2e-runs
