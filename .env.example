# im-align e2e harness credentials template.
# Copy to .env, fill in real values, and load with: set -a && source .env && set +a
# .env contains live secrets; it is gitignored and must never be committed.
# Reference: docs/test/test-layers.md

# --- Feishu/Lark Bridge app (L2 IM Integration and above) ---
# The app behind the Bridge; needs the long-connection event im.message.receive_v1
# and the scopes in references/lark-scopes.json. IM_ALIGN_E2E_CHAT_ID is a
# dedicated test group; when unset, L2 falls back to im.chat_id in the
# launching repository's .im-align.yaml.
IM_ALIGN_E2E_FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
IM_ALIGN_E2E_FEISHU_APP_SECRET=changeme
IM_ALIGN_E2E_CHAT_ID=oc_xxxxxxxxxxxxxxxx

# --- Supported user Participant (L2 IM Integration and above) ---
# Feishu-touching automation posts and verifies under this test-user identity.
# Local runs load a fresh access token from an authorized CLI credential store;
# the harness never writes it to Bridge config or state.
IM_ALIGN_E2E_USER_ACCESS_TOKEN=changeme

# CI does not store the short-lived access token. It stores the rotating OAuth
# refresh token and refreshes immediately before each serialized Feishu job.
# The refresh token must have been issued for the app above. A fine-grained PAT
# limited to this repository's Secrets: write permission persists each rotated
# refresh token through `gh secret set`; neither value reaches the Bridge.
IM_ALIGN_E2E_FEISHU_USER_REFRESH_TOKEN=changeme
IM_ALIGN_E2E_GITHUB_SECRETS_PAT=github_pat_changeme

# The Bridge bot open_id is normally resolved from its app credentials.
# Optional override for environments where identity lookup is unavailable:
# IM_ALIGN_E2E_BRIDGE_BOT_OPEN_ID=ou_xxxxxxxxxxxxxxxx

# --- Blocked bot Participant diagnostic (L3/L4 manual re-probe only) ---
# --participant-mode bot remains selectable for ADR-0006 compatibility, but
# ADR-0009 records that bot-originated messages do not reach the Bridge event
# stream. Such runs are expected to fail acknowledgement/Turn assertions until
# platform delivery is re-validated. Do not use --participant-mode all as a
# green acceptance gate.
# Optional simulator open_id override:
# IM_ALIGN_E2E_SIMULATOR_OPEN_ID=ou_xxxxxxxxxxxxxxxx
IM_ALIGN_E2E_SIMULATOR_APP_ID=cli_xxxxxxxxxxxxxxxx
IM_ALIGN_E2E_SIMULATOR_APP_SECRET=changeme

# --- User Simulator LLM (OpenAI-compatible chat-completions endpoint) ---
SIMULATOR_LLM_BASE_URL=https://your-llm-endpoint.example.com/v1
SIMULATOR_LLM_API_KEY=changeme
SIMULATOR_LLM_MODEL=changeme

# --- Run Evaluator LLM (OpenAI-compatible chat-completions endpoint) ---
# Also used by tests/e2e/calibrate.py for rubric calibration.
EVALUATOR_LLM_BASE_URL=https://your-llm-endpoint.example.com/v1
EVALUATOR_LLM_API_KEY=changeme
EVALUATOR_LLM_MODEL=changeme

# --- Optional: archive root for run artifacts (transcript.json, rubric.json) ---
# Defaults to $XDG_STATE_HOME/im-align/e2e-runs (~/.local/state/im-align/e2e-runs).
# IM_ALIGN_E2E_RUNS_DIR=/absolute/path/to/e2e-runs
